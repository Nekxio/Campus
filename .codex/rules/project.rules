# Commandes destructrices : confirmation ou blocage dans Codex.
# .codex/rules/project.rules. Chargé seulement si le projet est de confiance.
# Fonction expérimentale de Codex. Couvre les formes usuelles (le motif est un préfixe exact),
# pas les variantes : ce n’est pas une frontière de sécurité.
# Tester : codex execpolicy check --pretty --rules .codex/rules/project.rules -- git push --force

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Pas de push forcé : faire un push normal, ou me demander.",
    match = ["git push --force origin main", "git push -f", "git push --force-with-lease"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Pas de push forcé : faire un push normal, ou me demander.",
    match = ["git push origin --force", "git push origin -f main", "git push origin --force-with-lease"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-R", "-Rf", "--recursive"]],
    decision = "prompt",
    justification = "Suppression récursive : confirmer la cible.",
    match = ["rm -rf build", "rm -r dist", "rm --recursive tmp"],
    not_match = ["rm notes.txt"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Perte des modifications non commitées.",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Suppression des fichiers non suivis.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "Suppression forcée d’une branche.",
    match = ["git branch -D feature"],
    not_match = ["git branch -d feature"],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "prompt",
    justification = "Abandon des modifications en cours.",
    match = ["git checkout -- .", "git checkout -- src/app.ts"],
    not_match = ["git checkout main"],
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "Abandon des modifications en cours.",
    match = ["git restore src/app.ts", "git restore --staged ."],
)

prefix_rule(
    pattern = ["git", "push", ["--delete", "-d"]],
    decision = "prompt",
    justification = "Suppression d’une branche distante.",
    match = ["git push --delete origin feature"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--delete", "-d"]],
    decision = "prompt",
    justification = "Suppression d’une branche distante.",
    match = ["git push origin --delete feature"],
)
