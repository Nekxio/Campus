{
	"name": "campus",
	"private": true,
	"version": "1.0.0-SNAPSHOT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync",
		"check": "pnpm gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts && tsc -p scripts/tsconfig.json",
		"check:watch": "pnpm gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "node --import=./scripts/prepare-tests.ts --import=./scripts/test-isolation.mjs node_modules/vitest/vitest.mjs",
		"test:mutation": "node --import=./scripts/prepare-tests.ts node_modules/@stryker-mutator/core/bin/stryker.js run",
		"test:worker": "node --test tests/worker/*.test.mjs",
		"test": "pnpm test:unit --run",
		"gen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-file /dev/null",
		"ai:svelte": "svelte-mcp",
		"test:browser": "node --import=./scripts/prepare-tests.ts node_modules/@playwright/test/cli.js test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@levischuck/tiny-cbor": "0.3.6",
		"@lucide/svelte": "1.65.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@playwright/test": "1.64.0",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/mcp": "0.1.27",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "26.6.5",
		"@types/pdfmake": "0.3.3",
		"@types/ws": "8.18.2",
		"bits-ui": "2.20.2",
		"cn": "0.5.1",
		"drizzle-kit": "0.31.10",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.1.0",
		"globals": "^17.6.0",
		"miniflare": "5.20261101.0-beta",
		"pdfjs-dist": "6.4.299",
		"pdfmake": "0.3.12",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "4.7.7",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "4.23.14",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "^8.3.0",
		"vitest": "4.1.12",
		"wrangler": "4.156.1",
		"ws": "8.22.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=26.11.1 <27",
		"pnpm": ">=12.11.2 <13"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.14",
		"@better-auth/drizzle-adapter": "1.7.14",
		"@better-auth/mcp": "1.7.14",
		"@better-auth/oauth-provider": "1.7.14",
		"@better-auth/passkey": "1.7.14",
		"@libsql/client": "0.18.0",
		"@modelcontextprotocol/server": "2.3.1",
		"better-auth": "1.7.14",
		"drizzle-orm": "0.45.4",
		"ical.js": "^2.2.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "1.2.2",
		"zod": "4.6.6"
	}
}
