{
	"name": "coursely",
	"private": true,
	"version": "1.0.0-SNAPSHOT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"worker:dry-run": "tsx scripts/worker-dry-run.ts",
		"production:prepare": "tsx scripts/production.ts prepare",
		"production:migrate": "tsx scripts/production-migration.ts",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run",
		"gen": "wrangler types",
		"ai:svelte": "svelte-mcp",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
		"db:fixtures": "tsx scripts/db-fixtures.ts",
		"auth:invite": "tsx --env-file-if-exists=.env scripts/auth-invite.ts",
		"auth:revoke": "tsx --env-file-if-exists=.env scripts/auth-revoke.ts",
		"agent:key": "tsx --env-file-if-exists=.env scripts/agent-key.ts",
		"mcp": "tsx scripts/coursely-mcp.ts",
		"test:browser": "playwright test",
		"check:browser": "tsc --noEmit -p tests/browser/tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@levischuck/tiny-cbor": "0.3.6",
		"@lucide/svelte": "^1.55.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/mcp": "0.1.26",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pdfmake": "0.3.3",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"drizzle-kit": "0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"pdfjs-dist": "6.4.299",
		"pdfmake": "0.3.11",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "4.20.6",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=26.11.1 <27",
		"pnpm": ">=12.11.2 <13"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.7",
		"@better-auth/drizzle-adapter": "1.7.7",
		"@better-auth/mcp": "1.7.7",
		"@better-auth/oauth-provider": "1.7.7",
		"@better-auth/passkey": "1.7.7",
		"@libsql/client": "0.18.0",
		"@modelcontextprotocol/server": "2.3.1",
		"better-auth": "1.7.7",
		"drizzle-orm": "0.45.4",
		"mode-watcher": "^1.1.0",
		"zod": "^4.6.5"
	}
}
