# Dedicated Coursely database. Never reuse the prototype database by default.
TURSO_DATABASE_URL="libsql://your-coursely-database.turso.io"
TURSO_AUTH_TOKEN=""

# Exact and stable origin; HTTPS is required except for loopback development.
# Use the preview port (4173) when testing the built Worker locally.
ORIGIN="http://localhost:5173"

# Server-only high-entropy secret (at least 32 characters).
# Generate one locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Production preparation only; these values are not loaded automatically by production:prepare.
# Namespace supplied by Léo. Worker availability/account ownership has not been verified remotely.
# The generated Worker config sets runtime ORIGIN to this exact HTTPS origin.
COURSELY_PRODUCTION_ORIGIN="https://mds.leohilaire-1f7.workers.dev"
# Non-secret account ID supplied by Léo; account access/namespace ownership remains unverified.
CLOUDFLARE_ACCOUNT_ID="1f7361109db586cc5f7f3f7c8ea636e6"
